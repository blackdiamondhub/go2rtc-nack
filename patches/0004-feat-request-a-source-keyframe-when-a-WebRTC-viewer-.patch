+// floodKeyframe calls RequestKeyframe from 50 goroutines for d.
+func floodKeyframe(c *Conn, d time.Duration) {
+	var wg sync.WaitGroup
+	stop := time.Now().Add(d)
+	for i := 0; i < 50; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for time.Now().Before(stop) {
+				_ = c.RequestKeyframe()
+			}
+		}()
+	}
+	wg.Wait()
+}
