+func TestTalkRejectsBadFrames(t *testing.T) {
+	h := newHarness(t, "frames_talk", "talkback:rtp://192.168.1.136:7004?codec=opus&rate=24000")
+
+	for name, frame := range map[string][]byte{
+		"odd":   make([]byte, 641),
+		"large": make([]byte, maxFrame+2),
+		"empty": {},
+	} {
+		ws, _, err := h.dial("src=frames_talk", nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if m := readMsg(t, ws); m.Type != "ready" {
+			t.Fatalf("%s: got %+v, want ready", name, m)
+		}
+		_ = ws.WriteMessage(websocket.BinaryMessage, frame)
+		if m := readMsg(t, ws); m.Type != "error" {
+			t.Errorf("%s: got %+v, want error", name, m)
+		}
+		ws.Close()
+		time.Sleep(50 * time.Millisecond) // let the server release the speaker
+	}
+}
+
+func TestTalkRejectsFlood(t *testing.T) {
+	h := newHarness(t, "flood_talk", "talkback:rtp://192.168.1.137:7004?codec=opus&rate=24000")
+	ws, _, err := h.dial("src=flood_talk", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ws.Close()
+	if m := readMsg(t, ws); m.Type != "ready" {
+		t.Fatalf("got %+v", m)
+	}
+	// 5 s of audio as fast as possible exceeds the 2 s burst allowance
+	frame := make([]byte, maxFrame)
+	for i := 0; i < 50; i++ {
+		if err = ws.WriteMessage(websocket.BinaryMessage, frame); err != nil {
+			break
+		}
+	}
+	if m := readMsg(t, ws); m.Type != "error" || m.Value != errRate.Error() {
+		t.Fatalf("got %+v, want rate error", m)
+	}
+}
+
+func TestTalkRejectsRequests(t *testing.T) {
+	h := newHarness(t, "plain", "talkback:rtp://192.168.1.138:7004")
+
+	cases := []struct {
+		query  string
+		origin string
+		status int
+	}{
+		{"src=missing", "", http.StatusNotFound},
+		{"src=bad%20name", "", http.StatusBadRequest},
+		{"src=", "", http.StatusBadRequest},
+		{"src=plain", "http://evil.example", http.StatusForbidden},
+	}
+	for _, c := range cases {
+		header := http.Header{}
+		if c.origin != "" {
+			header.Set("Origin", c.origin)
+		}
+		_, resp, err := h.dial(c.query, header)
+		if err == nil {
+			t.Errorf("%s: expected dial failure", c.query)
+			continue
+		}
+		if resp == nil || resp.StatusCode != c.status {
+			code := 0
+			if resp != nil {
+				code = resp.StatusCode
+			}
+			t.Errorf("%s origin=%q: status %d, want %d", c.query, c.origin, code, c.status)
+		}
+		if resp != nil {
+			_, _ = io.Copy(io.Discard, resp.Body)
+			resp.Body.Close()
+		}
+	}
+}
